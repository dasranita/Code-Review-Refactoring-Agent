{
  "openapi": "3.1.0",
  "info": {
    "title": "Code Review & Refactoring Agent",
    "version": "1.0.0",
    "description": "AI-powered code review and refactoring API built with LangGraph."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/review": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Review and optionally refactor code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          },
          "503": {
            "description": "Configuration error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReviewRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "default": "python"
          },
          "goals": {
            "type": "string"
          },
          "include_refactor": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "ReviewResponse": {
        "type": "object",
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "type": "string"
          },
          "refactored_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}